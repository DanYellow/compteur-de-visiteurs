{% extends "layouts/email.njk" %}

{% block title %}
    Activation de passkey pour compte numixs
{% endblock %}

{% block content %}
    <table width="100%" cellpadding="0" cellspacing="0" class="px-3">
        <tr>
            <td align="center">
                <p class="m-1">Bonjour <span class="font-bold">{{ prenom }} {{ nom|uppercase }},</span></p>
                <p class="text-2xl font-bold text-gray-800 m-1">
                    Un passkey a été crée le <span class="font-bold">{{ date }}.</span> Vous pouvez valider ce passkey en cliquant sur le lien d'activation.
                </p>
            </td>
        </tr>
        <tr>
            <td align="center" class="py-2">
                <a
                    href="{{ activation_link }}"
                    class="px-4 py-2 inline-block bg-green-numixs text-gray-numixs rounded-md"
                >
                    Activer le passkey
                </a>
            </td>
        </tr>
        <tr>
            <td align="center">
                Si vous n'êtes pas à l'origine de cette action, veuillez vérifier votre compte.
            </td>
        </tr>
    </table>
{% endblock %}
