{% extends "layouts/email.njk" %}

{% block title %}
    Activation de passkey pour compte numixs
{% endblock %}

{% block content %}
    <p>Bonjour <span class="font-bold">{{ prenom }} {{ nom|uppercase }},</span></p>
    <p class="text-2xl font-bold text-gray-800 mb-4">
        Un passkey a été crée à <span class="font-bold">{{ date }}.</span> Vous pouvez valider ce passkey en cliquant sur le lien d'activation.
    </p>
    <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center">
                <a
                    href="{{ activation_link }}"
                    class="px-4 py-2 bg-green-numixs text-gray-numixs rounded-md"
                >
                    Activer le passkey
                </a>
            </td>
        </tr>
    </table>
    <p>
        Si vous n'êtes pas à l'origine de cette action, veuillez vérifier votre compte.
    </p>
{% endblock %}
