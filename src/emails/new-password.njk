{% extends "layouts/email.njk" %}

{% block content %}
    <p>Bonjour <span class="font-bold">{{ prenom }}
            {{ nom|uppercase }},</span></p>
    <p>
        Votre demande de récupération de mot de passe, du {{ date }}, a été prise en compte. Veuillez cliquer sur le lien ci-dessous pour effectuer le changement.
    </p>
    <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center">
                <a
                    href="{{ activation_link }}"
                    rel="noopener noreferrer"
                    class="px-4 py-2 bg-green-numixs text-gray-numixs rounded-md"
                >
                   Changer mon mot de passe
                </a>
            </td>
        </tr>
    </table>
    <p>
        Si vous n'êtes pas à l'origine de cette action, veuillez ignorer cet e-mail.
    </p>
{% endblock %}
