{% extends "layouts/email.njk" %}

{% block title %}
    Changement de mot de passe
{% endblock %}

{% block content %}
    <table width="100%" cellpadding="0" cellspacing="0" class="px-3">
        <tr>
            <td align="center">
                <p class="m-1">Bonjour <span class="font-bold">{{ prenom }} {{ nom|uppercase }},</span></p>
                <p class="m-1">
                    Votre demande de récupération de mot de passe, du {{ date }}, a été prise en compte.
                </p>
                <p class="m-1">
                    Veuillez cliquer sur le lien ci-dessous pour effectuer le changement.
                </p>
            </td>
        </tr>
        <tr>
            <td align="center" class="py-2">
                <p class="border-t-4 border-r-0 border-b-0 border-l-0 bg-amber-50 text-amber-800 border-t-amber-800 rounded-md p-3 my-1" style="border-top-style: solid;">
                    Attention le lien n'est actif que 30 minutes. S'il expire, il faudra refaire votre demande de changement de mot de passe.
                </p>
                <p class="mb-1">
                    <a
                        href="{{ activation_link }}"
                        rel="noopener noreferrer"
                        class="px-4 py-2 inline-block bg-green-numixs text-gray-numixs rounded-md"
                    >
                    Changer mon mot de passe
                    </a>
                </p>
            </td>
        </tr>
        <tr>
            <td align="center">
                Si vous n'êtes pas à l'origine de cette action, veuillez ignorer cet e-mail.
            </td>
        </tr>
    </table>
{% endblock %}
