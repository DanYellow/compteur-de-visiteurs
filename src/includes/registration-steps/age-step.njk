{% import "includes/macros.njk" as forms %}

<div class="flex flex-col gap-3">
    <div class="mb-11">
        <p class="title-font leading-none text-7xl uppercase">A quelle <span class="text-green-numixs">tranche d'âge</span> appartenez-vous ?</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-7">
        {% for age_range in list_age_ranges %}
        <div class="w-full text-black switch-container title-font font-bold bg-[#F5F5F5] rounded-md h-fit">
            <label class="w-full p-3 justify-between inline-flex items-center cursor-pointer text-2xl">
                <span>{{ age_range.label }}</span>
                <input type="radio" name="tranche_age" class="sr-only" value="{{ age_range.value }}" id="{{ age_range.value }}">
            </label>
        </div>
        {% endfor %}
    </div>
</div>
