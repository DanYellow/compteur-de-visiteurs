{% extends "layouts/page.njk" %}

{% set root_class = "register" %}
{% import "includes/macros.njk" as macros %}

{% block title %}
Connexion
{% endblock %}

{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/toggle-input-visibility.ts" defer></script>
        <script type="module" src="/src/assets/scripts/forms/login-form.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/toggle-input-visibility.ts'].file }}" defer></script>
        <script type="module" src="/{{ manifest['src/assets/scripts/forms/login-form.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="max-w-7xl mt-8 px-3 mx-auto">
        <div>
            <img src="/images/logos/faclab-numixs.svg" class="w-20" alt="">
            <h1 class="text-6xl title-font text-green-numixs">Connexion</h1>
        </div>
        <div class="flex flex-col gap-3 mb-4">
            {% if flash_message == "account_created" %}
                {% set banner_content %}
                    Votre compte a été confirmé, vous pouvez désormais vous connecter avec l'adresse e-mail <span class="font-bold">"{{ user_email }}"</span> et le mot de passe ou votre passkey définit précédemment.
                {% endset %}
                {{ macros.success_banner(banner_content) }}
            {% endif %}

            {% if flash_message == "success_logout" %}
                {{ macros.success_banner("Vous avez été déconnecté(e) avec succès.") }}
            {% endif %}

            {% if flash_message == "password_updated" %}
                {{ macros.success_banner("Votre mot de passe a été mis à jour, vous pouvez l'utiliser dès maintenant.") }}
            {% endif %}

            {% if flash_message == "forced_logout" %}
                {{ macros.warning_banner("Une erreur est survenue, vous avez été déconnecté(e).") }}
            {% endif %}

            {% if flash_message == "wrong_credentials" or flash_message == "user_not_found" %}
                {{ macros.error_banner("Identifiants incorrects.") }}
            {% endif %}

            {% if flash_message == "passkey_not_found" %}
                {{ macros.error_banner("Passkey inconnu.") }}
            {% endif %}

            {% if flash_message == "form_not_valid" %}
                {{ macros.error_banner("Veuillez remplir dûment le formulaire.") }}
            {% endif %}

            {% if flash_message == "not_logged" %}
                {{ macros.error_banner("Vous devez vous connecter pour accéder à cette page.") }}
            {% endif %}

            {% if flash_message == "user_exists" %}
                {{ macros.warning_banner("Ce compte a déjà été activé. Veuillez vous connecter avec le mot de passe que vous avez défini durant l'activation de votre compte dans le formulaire ci-dessous.") }}
            {% endif %}
        </div>

        <form action="/connexion" method="post" novalidate>
            <ul class="form-errors-list-container" role="alert" data-form-errors id="error-container"></ul>

            <div class="grid md:grid-cols-[1fr_auto_1fr] gap-x-4 gap-y-2 items-center">
                <div class="flex flex-col gap-3">
                    <div class="flex flex-col">
                        <label for="email">Identifiant</label>
                        <input type="email" id="email" name="email" value="{{ user_email }}" autocomplete="username webauthn" class="text-black">
                    </div>
                    <div class="flex flex-col">
                        <label for="mot_de_passe">Mot de passe</label>
                        <input type="password" name="mot_de_passe" id="mot_de_passe" class="text-black w-full" autocomplete="current-password webauthn" data-input-toggle-visibility>
                    </div>
                    <div class="flex flex-col md:flex-row justify-between">
                        <button type="submit" class="text-green-numixs inline-flex w-fit title-font text-2xl gap-2.5 py-3.5 font-bold hocus:text-white items-center">
                            Se connecter
                            {% include "includes/icons/next-arrow.svg" %}
                        </button>
                        <a href="/mot-de-passe-oublie" class="text-white-numixs w-fit title-font text-2xl py-3.5 font-bold hocus:text-white">Mot de passe oublié ?</a>
                    </div>
                </div>
                <p class="text-lg text-center" data-passkey-toggle>ou</p>

                <button type="button" data-passkey-login class="inert:!cursor-not-allowed inert:opacity-60 p-3 border bg-green-numixs text-black-numixs border-transparent hocus:border-green-numixs hocus:bg-transparent hocus:text-green-numixs" data-passkey-toggle>
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 inline">
                            <path fill-rule="evenodd" d="M12 3.75a6.715 6.715 0 0 0-3.722 1.118.75.75 0 1 1-.828-1.25 8.25 8.25 0 0 1 12.8 6.883c0 3.014-.574 5.897-1.62 8.543a.75.75 0 0 1-1.395-.551A21.69 21.69 0 0 0 18.75 10.5 6.75 6.75 0 0 0 12 3.75ZM6.157 5.739a.75.75 0 0 1 .21 1.04A6.715 6.715 0 0 0 5.25 10.5c0 1.613-.463 3.12-1.265 4.393a.75.75 0 0 1-1.27-.8A6.715 6.715 0 0 0 3.75 10.5c0-1.68.503-3.246 1.367-4.55a.75.75 0 0 1 1.04-.211ZM12 7.5a3 3 0 0 0-3 3c0 3.1-1.176 5.927-3.105 8.056a.75.75 0 1 1-1.112-1.008A10.459 10.459 0 0 0 7.5 10.5a4.5 4.5 0 1 1 9 0c0 .547-.022 1.09-.067 1.626a.75.75 0 0 1-1.495-.123c.041-.495.062-.996.062-1.503a3 3 0 0 0-3-3Zm0 2.25a.75.75 0 0 1 .75.75c0 3.908-1.424 7.485-3.781 10.238a.75.75 0 0 1-1.14-.975A14.19 14.19 0 0 0 11.25 10.5a.75.75 0 0 1 .75-.75Zm3.239 5.183a.75.75 0 0 1 .515.927 19.417 19.417 0 0 1-2.585 5.544.75.75 0 0 1-1.243-.84 17.915 17.915 0 0 0 2.386-5.116.75.75 0 0 1 .927-.515Z" clip-rule="evenodd"/>
                        </svg>
                        Se connecter avec un passkey
                    </div>
                </button>
            </div>
        </form>
    </div>
    {% include "includes/toggle-input-visibility.njk" %}
{% endblock %}
