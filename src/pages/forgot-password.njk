{% extends "layouts/page.njk" %}

{% set root_class = "register" %}
{% import "includes/macros.njk" as macros %}

{% block title %}
Mot de passe oublié ?
{% endblock %}

{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/forms/password-recovery-form.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/forms/password-recovery-form.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="max-w-7xl mt-8 px-3 mx-auto">
        <div>
            <img src="/images/logos/faclab-numixs.svg" class="w-20" alt="">
            <h1 class="text-6xl title-font text-green-numixs">Mot de passe oublié ?</h1>
        </div>
        <div class="flex flex-col gap-3 mb-4">
            {% if flash_message == "form_success" %}
                {% set banner_content %}
                    Votre demande a été prise en compte, vous allez recevoir un e-mail, à l'adresse <span class="font-bold">"{{ user_email }}"</span>, expliquant comment réinitialiser votre mot de passe.
                {% endset %}
                {{ macros.success_banner(banner_content) }}
            {% endif %}

            {% if flash_message == "form_not_valid" %}
                {{ macros.error_banner("Le formulaire a mal été rempli.") }}
            {% endif %}

            {% if flash_message == "user_not_found" %}
                {{ macros.error_banner("Ce compte n'existe pas.") }}
            {% endif %}
        </div>

        <form action="" method="post" novalidate>
            <ul class="form-errors-list-container" role="alert" data-form-errors id="error-container"></ul>

            <div class="flex flex-col gap-y-2">
                <div class="flex flex-col gap-3">
                    <div class="flex flex-col">
                        <label for="email">Identifiant</label>
                        <input type="email" id="email" name="email" value="{{ user_email }}" class="text-black">
                    </div>
                </div>
                <div class="flex flex-row justify-between">
                        <button type="submit" class="text-green-numixs inline-flex w-fit title-font text-2xl gap-2.5 py-3.5 font-bold hocus:text-white items-center">
                            Récupérer mot de passe
                            {% include "includes/icons/next-arrow.svg" %}
                        </button>
                        <a href="/connexion" class="text-white-numixs w-fit title-font text-2xl py-3.5 font-bold hocus:text-white-numixs/80">Mon mot de passe m'est revenu</a>
                    </div>
            </div>
        </form>
    </div>
    {% include "includes/toggle-input-visibility.njk" %}
{% endblock %}
