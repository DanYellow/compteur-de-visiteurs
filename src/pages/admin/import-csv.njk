{% extends "layouts/admin.njk" %}

{% block title %}
    Importer csv de visites
{% endblock %}
{% set active_menu_item = "visiteurs" %}
{% import "includes/macros.njk" as macros %}

{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/forms/import-csv-visits-form.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/forms/event-form.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}

{% set date_format = "dd/LL/yyyy à HH:mm" %}
{% set root_class = "admin" %}
{% block content %}
<div class="bg-slate-50 rounded-md py-5 px-6 md:py-10 md:px-13">
    <header class="flex flex-row justify-between md:items-center mb-10 -mt-1.5">
        <h1 class="text-black-numixs title-font font-bold text-4xl md:text-6xl">
            Importer csv de visites
        </h1>
    </header>
    <div class="flex flex-col gap-3 mb-4">
        {% include "includes/hello-banner.njk" %}
    </div>

    <div class="text-black-numixs">
        <form action="" method="post" class="flex flex-col gap-5" data-import-csv-form enctype="multipart/form-data">
            <div class="flex flex-col gap-2.5">
                {% if flash_message.error %}
                    {{ macros.error_banner("Une erreur est survenue")}}
                {% endif %}

                {% if flash_message.import_success %}
                    {{ macros.success_banner("Les données ont été importées avec succès")}}
                {% endif %}

                <ul class="form-errors-list-container" role="alert" data-form-errors id="error-container"></ul>
                {{ macros.info_banner("Les champs avec * sont obligatoires.")}}
            </div>
            <div class="flex flex-col">
                <label for="file" class="font-bold text-lg">Rapport de visites csv*</label>
                <input
                    type="file"
                    name="file" id="file"  accept=".csv"
                    class="block w-full text-sm text-slate-500
                        file:mr-4 file:py-2 file:px-4 file:rounded-md
                        file:border-0 file:text-sm file:font-semibold
                        file:bg-green-numixs/40 file:text-gray-numixs
                        hover:file:bg-green-numixs p-0.5 border-1 border-gray-numixs border-solid"
                />
                <div class="p-2 mt-2 text-xs bg-amber-50 text-amber-800 border-t-4 border-1 border-amber-800/30 border-t-amber-800 rounded-md">
                    <p>Notes : </p>
                    <ul class="ml-3 list-disc">
                        <li>Les visites avec une date incorrecte seront ignorées</li>
                        <li>La date de la visite doit être au format jj//mm/aa</li>
                        <li>L'heure de visite sera égale à l'heure d'ouverture du lieu sélectionné ci-dessous</li>
                        <li>Le traitement de l'import est basé sur le Google Doc "Rapport de visites"</li>
                        <li>La fonctionnalité ne gère pas les données dupliquées, c'est à vous d'éviter d'importer une nouvelle fois des données</li>
                    </ul>
                </div>
            </div>

            <div class="flex flex-col">
                <label for="place-dropdown" class="font-bold text-lg">Lieu*</label>
                <select name="lieu" id="place-dropdown" class="py-1 custom-select !pr-10">
                    <button>
                        <selectedcontent></selectedcontent>
                    </button>
                    <option value="">Sélectionnez un lieu</option>
                    {% if list_places | length %}
                    {% for place in list_places %}
                        <option value="{{ place.id }}">
                            <div class="flex gap-3 items-center">
                                <img width="70" class="img" src="/images/logos/{{ place.logo }}" alt="">
                                <span>{{ place.nom }}</span>
                            </div>
                        </option>
                    {% endfor %}
                {% endif %}
                </select>

            </div>

            <button type="submit" class="{{ primary_button_classes }}">
            Soumettre
            <svg width="23" height="22" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.723633 11C0.723633 13.0767 1.37686 15.1068 2.60072 16.8335C3.82458 18.5602 5.56409 19.906 7.59929 20.7007C9.63449 21.4955 11.874 21.7034 14.0345 21.2982C16.1951 20.8931 18.1797 19.8931 19.7373 18.4246C21.295 16.9562 22.3558 15.0852 22.7856 13.0484C23.2153 11.0116 22.9948 8.90045 22.1518 6.98182C21.3088 5.0632 19.8812 3.42332 18.0495 2.26957C16.2179 1.11581 14.0645 0.5 11.8616 0.5C8.90763 0.5 6.07465 1.60625 3.98587 3.57538C1.89709 5.54451 0.723633 8.21523 0.723633 11ZM5.49705 10.25H15.1632L10.7239 6.04475L11.8616 5L18.2262 11L11.8616 17L10.7239 15.9298L15.1632 11.75H5.49705V10.25Z" fill="currentColor"></path>
                </svg>
            </button>
        </div>
    </form>
</div>
{% endblock %}
