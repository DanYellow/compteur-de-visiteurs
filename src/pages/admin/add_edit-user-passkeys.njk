{% extends "layouts/page.njk" %}

{% block title %}
    Éditer passkey
{% endblock %}
{% set active_menu_item = "utilisateurs" %}
{% import "includes/macros.njk" as forms %}

{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/list-passkeys.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/list-passkeys.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}

{% if current_user.id == user.id %}
    {% set active_menu_item = "mon-compte" %}
{% else %}
    {% set active_menu_item = "utilisateurs" %}
{% endif %}

{% set active_user_menu_item = "passkeys" %}

{% set date_format = "dd/LL/yyyy à HH:mm" %}
{% set root_class = "admin" %}
{% block content %}
    <div data-notifications-container class="fixed left-2 top-2 z-50 empty:h-0"></div>
    <div class="mt-8 pr-[max(env(safe-area-inset-right),_theme(space.3))] pl-[max(env(safe-area-inset-left),_theme(space.3))] grid grid-cols-1 xl:grid-cols-[260px_minmax(0,_1fr)] gap-6 text-black-numixs">
        {% include "includes/admin-nav.njk" %}
        <div class="bg-slate-50 rounded-md py-5 px-6 md:py-10 md:px-13">
            {% include "includes/admin-user-nav.njk" %}
            <header class="flex flex-row justify-between md:items-center mb-10 -mt-1.5">
                <h1 class=" title-font font-bold text-4xl md:text-6xl">
                    Liste Passkeys
                </h1>
                <label class="cursor-pointer has-disabled:opacity-80 has-disabled:cursor-not-allowed flex gap-2">
                    Se connecter avec un mot de passe
                    <input type="checkbox" value="{{ user.utilise_mdp }}" {{ "checked" if user.utilise_mdp == 1 else "" }} {{ "disabled" if user.listPasskeys|length == 0 else "" }} data-change-user-pass-activation data-user-id="{{ user.id }}" class="sr-only peer">
                    <div class="switch relative border-solid border-black-numixs/30 border w-11 h-6 bg-[#C3CAD8] peer-focus:outline-none peer-focus:ring-4 peer-checked:bg-green-numixs rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:bg-black-numixs peer-checked:after:border-black-numixs after:content-[''] after:absolute after:border-black-numixs/30 after:top-[1px] after:start-[1px] after:bg-white after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-focus:ring-dark-green-numixs/30"></div>
                </label>
            </header>

            <div>
                <h2 class="text-lg font-bold">Un passkey, c'est quoi ?</h2>
                <p>Un passkey est un mot de passe de moderne et infalsifiable. Il vient combler les limites des mots de passe traditionnels qui peuvent être volés. En effet, le passkey permet l'authentification biométrique (empreinte digitale, reconnaissance faciale, yubikey...), ainsi plus de mots de passe à retenir et mots de passe invulnérables à toute compromission de base de données.</p>
                <p class="mt-2">Vous pouvez avoir plusieurs passkeys, il vous suffira de les gérer depuis votre espace "mon compte". Car chaque passkey est <span class="font-bold">associé à un appareil.</span> Toutefois, il existe des passkeys dit "synchronisés" qui sont liés à votre compte Apple, Google ou Microsoft.</p>
                <p class="mt-2">Si vous avez enregistré un passkey, vous pouvez augmenter la sécurité de votre compte en désactivant la connexion par mot de passe.</p>
            </div>

            {% include "includes/hello-banner.njk" %}

            <div class="text-black-numixs mt-5">
                {% include "includes/form-banner-success.njk" %}

                <h2 class="text-lg font-bold">Mes passkeys</h2>

                <ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4.5 mt-2">
                    <li data-passkey-toggle>
                        <button type="button" class="inert:!cursor-not-allowed inert:opacity-60 p-3 border h-full w-full bg-green-numixs text-black-numixs border-dark-green-numixs hocus:bg-dark-green-numixs hocus:text-black hocus:border-black rounded-md" data-passkey-register="{{ user.email }}">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 inline">
                                <path fill-rule="evenodd" d="M12 3.75a6.715 6.715 0 0 0-3.722 1.118.75.75 0 1 1-.828-1.25 8.25 8.25 0 0 1 12.8 6.883c0 3.014-.574 5.897-1.62 8.543a.75.75 0 0 1-1.395-.551A21.69 21.69 0 0 0 18.75 10.5 6.75 6.75 0 0 0 12 3.75ZM6.157 5.739a.75.75 0 0 1 .21 1.04A6.715 6.715 0 0 0 5.25 10.5c0 1.613-.463 3.12-1.265 4.393a.75.75 0 0 1-1.27-.8A6.715 6.715 0 0 0 3.75 10.5c0-1.68.503-3.246 1.367-4.55a.75.75 0 0 1 1.04-.211ZM12 7.5a3 3 0 0 0-3 3c0 3.1-1.176 5.927-3.105 8.056a.75.75 0 1 1-1.112-1.008A10.459 10.459 0 0 0 7.5 10.5a4.5 4.5 0 1 1 9 0c0 .547-.022 1.09-.067 1.626a.75.75 0 0 1-1.495-.123c.041-.495.062-.996.062-1.503a3 3 0 0 0-3-3Zm0 2.25a.75.75 0 0 1 .75.75c0 3.908-1.424 7.485-3.781 10.238a.75.75 0 0 1-1.14-.975A14.19 14.19 0 0 0 11.25 10.5a.75.75 0 0 1 .75-.75Zm3.239 5.183a.75.75 0 0 1 .515.927 19.417 19.417 0 0 1-2.585 5.544.75.75 0 0 1-1.243-.84 17.915 17.915 0 0 0 2.386-5.116.75.75 0 0 1 .927-.515Z" clip-rule="evenodd"/>
                            </svg>
                            <span class="text-lg">
                                Créer un passkey
                            </span>
                        </button>
                    </li>
                    {% set can_delete_passkey = (user.mot_de_passe != ""  and user.utilise_mdp == true) or user.listPasskeys | length > 1 %}
                    {% for passkey in user.listPasskeys %}
                        <li class="grid grid-cols-[1fr_auto] gap-2">
                            <button data-passkey="{{ passkey | json }}" command="show-modal" commandfor="manage-passkey" class="flex flex-col items-start border-black-numixs border p-3 w-full hocus:bg-black-numixs hocus:text-white-numixs rounded-md" type="button">
                                {% set has_been_used = (passkey.derniere_utilisation | date("yyyy") == "1970") %}
                                {% set date = passkey.derniere_utilisation | date("dd/LL/yyyy 'à' HH:mm") %}
                                <span class="text-lg font-bold leading-normal">{{ passkey.nom }}</span>
                                <span class="text-sm font-bold leading-none">Dernière utilisation : {{ "Jamais" if has_been_used else date }}</span>
                                <span class="text-sm leading-none">Crée le {{ passkey.date_creation | date("dd/LL/yyyy 'à' HH:mm") }}</span>
                            </button>
                            <div class="has-inert:cursor-not-allowed aspect-square h-full">
                                <button {{ "" if can_delete_passkey else "inert" }} data-item-id="{{ passkey.id }}" type="button" class="bg-red-800 text-white-numixs inert:opacity-75 hocus:text-red-800 hocus:bg-transparent p-3 aspect-square h-full rounded-md flex items-center justify-center border border-red-800" command="show-modal" commandfor="delete-passkey">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
                                        <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"/>
                                    </svg>
                                </button>
                            </div>
                        </li>
                    {% else %}
                        <li class="text-lg">Aucun passkey n'a été enregistré</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
<dialog id="manage-passkey" class="bg-black-numixs shadow-2xl rounded-md p-3 text-white-numixs backdrop:bg-black-numixs/35 -translate-1/2 left-1/2 top-1/2 w-11/12 max-w-3xl border border-solid border-green-numixs">
    <header class="flex flex-row justify-between items-start">
        <div>
            <p class="title-font text-4xl">Éditer passkey</p>
        </div>
    </header>
    <hr class="pb-1 mt-1 border-green-numixs">
    <form action="" method="POST">
        <div class="flex flex-col gap-2">
            <input type="hidden" name="id" id="id">
            <div class="flex flex-col">
                <label for="nom">Nom</label>
                <input class="text-black-numixs" type="text" name="nom" id="nom">
            </div>
            <div class="flex flex-row gap-3 mt-5">
                <button type="submit" class="rounded-md gap-2.5 px-3 py-1.5 bg-green-numixs text-black-numixs hocus:bg-dark-green-numixs hocus:text-black items-center">
                    Éditer
                </button>
                <button type="button" command="close" commandfor="manage-passkey" class="text-white-numixs rounded-md hocus:opacity-70 items-center border hocus:border-white-numixs border-transparent px-3 py-1.5">
                    Annuler
                </button>
            </div>
        </div>
    </form>
</dialog>

<dialog id="delete-passkey" data-delete-item-dialog class="bg-black-numixs shadow-2xl rounded-md p-3 text-white-numixs backdrop:bg-black-numixs/35 -translate-1/2 left-1/2 top-1/2 w-11/12 max-w-3xl border border-solid border-green-numixs">
    <header class="flex flex-row justify-between items-start">
        <div>
            <p class="title-font text-4xl">Supprimer passkey</p>
        </div>
    </header>
    <hr class="pb-1 mt-1 border-red-800">

    <p class="p-4 bg-red-50 text-red-800 border-t-4 border-t-red-800 mb-4">Cette action est irréversible.</p>

    <form method="POST" action="{{ admin_prefix }}/utilisateur/passkey/suppression">
        <input type="hidden" name="passkeyId" id="passkeyId" value=""/>
        <input type="hidden" name="userId" value="{{ user.id }}"/>
        <div class="flex flex-row gap-3">
            <button type="submit" class="text-white-numixs bg-red-800 hocus:bg-red-950 px-3 py-1.5 rounded-md">Supprimer</button>
            <button type="button" command="close" commandfor="delete-passkey" class="bg-black-numixs hocus:bg-black px-3.5 py-1.5 rounded-md text-white-numixs">Annuler</button>
        </div>
    </form>
</dialog>
{% endblock %}
