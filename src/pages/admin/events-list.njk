{% extends "layouts/admin.njk" %}

{% block title %}
Liste des évènements
{% endblock %}

{% import "includes/macros.njk" as macros %}
{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/details-event-dialog.ts" defer></script>
        <script type="module" src="/src/assets/scripts/download-chart.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/download-chart.ts'].file }}" defer></script>
        <script type="module" src="/{{ manifest['src/assets/scripts/details-event-dialog.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}

{% set active_menu_item = "evenement" %}
{% set place_selected = place.slug or "tous" %}
{% set date_format = "dd/LL/yyyy à HH:mm" %}
{% set root_class = "admin" %}
{% block content %}
    <div class="bg-slate-50 rounded-md py-5 px-6 md:py-10 md:px-13" data-place='{{ place | json }}'>
        <header class="flex flex-col md:flex-row justify-between md:items-center mb-10 -mt-1.5 gap-3">
            <div class="text-black-numixs flex flex-col items-start">
                <h1 class="title-font font-bold text-6xl">Évènements</h1>
                <p>Gestion des ouvertures des lieux en dehors des horaires habituels</p>
                <label for="dropdown" class="text-sm">Période</label>
                <select data-select-redirect="periode" id="dropdown" class="py-1">
                    <option value="">Tous</option>
                    <option {{ "selected" if periode == "a-venir" else "" }} value="a-venir">A venir</option>
                </select>
            </div>
            <a href="{{ admin_prefix }}/evenement" class="bg-black-numixs hocus:bg-black px-3.5 py-1.5 rounded-md text-white self-start md:self-auto">Créer un évènement</a>
        </header>

        <div class="flex flex-col gap-3 mb-4">
            {% include "includes/hello-banner.njk" %}
            {{ macros.info_banner("Les évènements associés à un lieu s'afficheront dans le calendrier.")}}
            {% include "includes/form-banner-success.njk" %}
        </div>

        <div class="text-black-numixs">
            <ul class="flex flex-row gap-2 text-xl mb-1.5">
                <li>
                    <a href="?" class="mr-3 hocus:text-dark-green-numixs {{ "border-b-2" if (current_year == year) else "" }}">Tous</a>
                </li>
                {% for year in list_years %}
                    <li>
                        <a href="?annee={{ year }}" class="hocus:text-dark-green-numixs {{ "border-b-2" if (current_year == year) else "" }}">{{ year }}</a>
                    </li>
                {% endfor %}
            </ul>
            <div class="overflow-x-auto">
                <table class="w-full bg-white border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="bg-gray-200">
                            <td class="font-bold px-4 py-3 text-left">#</td>
                            <td class="font-bold px-4 py-3 text-left">Nom</td>
                            <td class="font-bold px-4 py-3 text-left">Jour</td>
                            <td class="font-bold px-4 py-3 text-left">Heures d'ouverture</td>
                            <td class="font-bold px-4 py-3 text-left">Lieux concernés</td>
                            <td class="font-bold px-4 py-3 text-left">Nombre de visites<br>(tous lieux confondus)</td>
                            <td class="font-bold px-4 py-3 text-left"></td>
                            <td class="font-bold px-4 py-3 text-left"></td>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events_list %}
                            <tr class="even:bg-green-numixs/50 group hover:bg-slate-200" data-member-row>
                                <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">{{ loop.index }}</td>
                                <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">{{ event.nom }}</td>
                                <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                    <time datetime="{{ event.date }}">
                                        {{ event.date|date("dd/LL/yyyy") }}
                                    </time>
                                </td>
                                <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                    {{ event.heure_ouverture|date("HH'h'mm") }}-{{ event.heure_fermeture|date("HH'h'mm") }}
                                </td>
                                <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                    {% if event.listPlaces | length %}
                                        {% set offset = 1 %}
                                        {% for place in event.listPlaces %}
                                            {% if loop.index0 < offset %}
                                                {{ place.nom }}
                                                {% if loop.index0 < loop.last - 1 %}
                                            ,
                                            {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                        {% if event.listPlaces|length - offset > 0 %}
                                    +{{ event.listPlaces|length - offset }}
                                        {% endif %}
                                    {% else %}
                                    Aucun
                                    {% endif %}
                                </td>
                                 <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                    {{ event.nombre_de_visites }}
                                </td>

                                <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                    <a href="{{ admin_prefix }}/evenement/{{ event.id }}" class="font-bold hocus:opacity-75">Éditer</a>
                                </td>
                                <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3">
                                    <button type="button" class="align-middle hocus:opacity-80" title="Voir détails" commandfor="detail-event" command="show-modal" data-event-data='{{ event | json }}'>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                                            <path d="M8.25 10.875a2.625 2.625 0 1 1 5.25 0 2.625 2.625 0 0 1-5.25 0Z"/>
                                            <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.125 4.5a4.125 4.125 0 1 0 2.338 7.524l2.007 2.006a.75.75 0 1 0 1.06-1.06l-2.006-2.007a4.125 4.125 0 0 0-3.399-6.463Z" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        {% else %}
                            <tr class="">
                                <td colspan="7" class="px-4 py-3 text-center">
                                    Aucune données
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {# {% include "includes/pagination.njk" %} #}
        </div>
    </div>

    <dialog id="detail-event" closedby="any" class="bg-black-numixs shadow-2xl rounded-md p-3 text-white-numixs backdrop:bg-black-numixs/35 -translate-1/2 left-1/2 top-1/2 w-11/12 max-w-3xl border border-solid border-green-numixs">
        <header class="flex flex-row justify-between items-start">
            <div>
                <p class="title-font text-4xl" data-name></p>
                <p class="text-sm">
                    Le <time datetime="">14/11/2025 de 10:47:56 à 12:47:56</time>
                </p>
                <p class="text-sm" data-place-name></p>
            </div>
            <button type="button" command="close" commandfor="detail-event" class="text-white-numixs hocus:text-green-numixs cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
                </svg>
            </button>
        </header>

        <hr class="pb-1 mt-1 border-green-numixs">
        <p data-description=""></p>
        <div class="p-3 rounded-2xl h-100 relative">
            <menu class="absolute right-3 flex flex-col items-end gap-1">
                <li>
                    <button data-download-chart="global-chart" type="button" class="text-white-numixs hocus:text-green-numixs cursor-pointer extensible-button" title="Télécharger graphique">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
                        </svg>
                        <span class="inline-flex items-center">Télécharger graphique (.jpg)</span>
                    </button>
                </li>
                <li>
                    <a href="" id="data-download-csv-data" download class="text-white-numixs hocus:text-green-numixs cursor-pointer extensible-button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0 1 12 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M13.125 12h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125M20.625 12c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5M12 14.625v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 14.625c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m0 1.5v-1.5m0 0c0-.621.504-1.125 1.125-1.125m0 0h7.5"/>
                        </svg>
                        <span class="inline-flex items-center">Télécharger csv</span>
                    </a>
                </li>
            </menu>
            <canvas id="global-chart" class="w-full h-full"></canvas>
        </div>
        <p class="text-xl">Lieu(x) concerné(s)</p>
        <ul class="list-disc list-inside columns-2"></ul>
    </dialog>
{% endblock %}
