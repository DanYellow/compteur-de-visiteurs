{% extends "layouts/page.njk" %}

{% block title %}
Liste utilisateurs
{% endblock %}

{% import "includes/macros.njk" as macros %}

{% set active_menu_item = "utilisateurs" %}
{% set date_format = "dd/LL/yyyy à HH:mm" %}
{% set root_class = "admin" %}

{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/toggle-user-status.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/toggle-user-status.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}
{% block content %}
    <div data-notifications-container class="fixed left-2 top-2 z-50 empty:h-0"></div>
    <div class="mt-8 pr-[max(env(safe-area-inset-right),_theme(space.3))] pl-[max(env(safe-area-inset-left),_theme(space.3))] grid grid-cols-1 xl:grid-cols-[260px_minmax(0,_1fr)] gap-6">
        {% include "includes/admin-nav.njk" %}
        <div class="bg-slate-50 rounded-md py-5 px-6 md:py-10 md:px-13">
            <header class="flex flex-col md:flex-row gap-y-3 justify-between md:items-center mb-10 -mt-1.5">
                <div class="text-black-numixs">
                    <h1 class=" title-font font-bold text-6xl">Utilisateurs</h1>
                    <select data-select-redirect="actif" id="dropdown" class="py-1">
                        <option value="">Tous</option>
                        <option {{ "selected" if actif == "1" else "" }}  value="1">A activer</option>
                    </select>
                </div>
            </header>

            {% include "includes/hello-banner.njk" %}

            <div class="text-black-numixs">
                <div class="overflow-x-auto">
                    {% include "includes/form-banner-success.njk" %}
                    <table class="w-full bg-white border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="bg-gray-200">
                                <td class="font-bold px-4 py-3 text-left">#</td>
                                <td class="font-bold px-4 py-3 text-left">Prénom / Nom</td>
                                <td class="font-bold px-4 py-3 text-left">Adresse e-mail</td>
                                <td class="font-bold px-4 py-3 text-left">Rôle</td>
                                <td class="font-bold px-4 py-3 text-left">Actif</td>
                                <td class="font-bold px-4 py-3 text-left">Activer</td>
                                <td class="font-bold px-4 py-3 text-left">Date inscription</td>
                                <td class="font-bold px-4 py-3 text-left">Dernière connexion</td>
                                <td class="font-bold px-4 py-3 text-left"></td>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in list_users %}
                                <tr class="even:bg-green-numixs/50 group hover:bg-slate-200" data-member-row>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">{{ loop.index }}</td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">{{ user.prenom }}
                                        {{ user.nom }}</td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">{{ user.email }}</td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                        <span class="inline-flex items-center gap-2">
                                            {{ (list_roles|find({key: "value", value: user.role})).label }}
                                            <button type="button" class="align-middle hocus:opacity-80" title="Voir détails" commandfor="detail-roles" command="show-modal" data-event-data='{{ event | json }}'>
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                                    <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 0 1 .67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 1 1-.671-1.34l.041-.022ZM12 9a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"/>
                                                </svg>
                                            </button>
                                        </span>
                                    </td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">{{ "Oui" if user.actif == 1 else "Non" }}</td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                        <label class="cursor-pointer has-disabled:opacity-80 has-disabled:cursor-not-allowed">
                                            <input type="checkbox" value="{{ user.actif }}" {{ "checked" if user.actif == 1 else "" }} {{ "disabled" if user.actif == 1 and user.role == "ADMIN" else "" }} data-change-user-status="{{ user.id }}" class="sr-only peer">
                                            <div class="switch relative border-solid border-black-numixs/30 border w-11 h-6 bg-[#C3CAD8] peer-focus:outline-none peer-focus:ring-4 peer-checked:bg-green-numixs rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:bg-black-numixs peer-checked:after:border-black-numixs after:content-[''] after:absolute after:border-black-numixs/30 after:top-[1px] after:start-[1px] after:bg-white after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-focus:ring-dark-green-numixs/30"></div>
                                        </label>
                                    </td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">{{ user.date_inscription|date("dd/LL/yyyy 'à' HH:mm") }}</td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                        {% set has_been_used = (user.derniere_connexion | date("yyyy") == "1970") %}
                                        {% set date = user.derniere_connexion | date("dd/LL/yyyy 'à' HH:mm") %}

                                        {{ "Jamais" if has_been_used else date }}
                                    </td>
                                    <td class="group-hover:bg-slate-200 bg-gray-100 group-even:bg-green-numixs/50 px-4 py-3 text-left">
                                        <div class="flex flex-row gap-3">
                                            <a href="{{ admin_prefix }}/utilisateur/{{ user.id }}" class="font-bold hocus:opacity-75">Éditer</a>
                                            <button type="button" class="font-bold text-red-800 hover:text-red-950" commandfor="delete-user" command="show-modal" data-item-id="{{ user.id }}">Supprimer</button>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr class="">
                                    <td colspan="9" class="px-4 py-3 text-center">
                                        Pas d'utilisateurs
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <dialog id="delete-user" data-delete-item-dialog class="bg-black-numixs shadow-2xl rounded-md p-3 text-white-numixs backdrop:bg-black-numixs/35 -translate-1/2 left-1/2 top-1/2 w-11/12 max-w-2xl border border-solid border-green-numixs">
        <header class="flex flex-row justify-between items-start">
            <div>
                <p class="title-font text-4xl">Supprimer utilisateur</p>
            </div>
        </header>

        <hr class="pb-1 mt-1 border-red-800">

        <div class="mb-4">
            {{ macros.error_banner("Cette action est irréversible.")}}
        </div>

        <form method="POST" action="{{ admin_prefix }}/utilisateur/suppression">
            <input type="hidden" name="id" value=""/>
            <div class="flex flex-row gap-3">
                <button type="submit" class="text-white-numixs bg-red-800 hocus:bg-red-950 px-3 py-1.5 rounded-xl">Supprimer</button>
                <button type="button" command="close" commandfor="delete-user" class="bg-black-numixs hocus:bg-black px-3.5 py-1.5 rounded-xl text-white-numixs">Annuler</button>
            </div>
        </form>
    </dialog>

    {% include "includes/detail-roles.njk" %}
{% endblock %}
