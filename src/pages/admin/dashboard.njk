{% extends "layouts/admin.njk" %}

{% block title %}
Tableau de bord – {{ current_date|date("EEEE dd LLLL yyyy") }}
{% endblock %}

{% import "includes/macros.njk" as macros %}

{% set root_class = "admin" %}
{% set active_menu_item = "dashboard" %}
{% set date_format = "dd/LL/yyyy à HH:mm" %}
{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/dashboard.ts" defer></script>
        <script type="module" src="/src/assets/scripts/download-chart.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/download-chart.ts'].file }}" defer></script>
        <script type="module" src="/{{ manifest['src/assets/scripts/dashboard.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}
{% block content %}
    {% set place_selected = place.slug %}
    <div class="bg-slate-50 rounded-md py-5 px-6 md:py-10 md:px-13" data-place="{{ place | json }}" data-list-events="{{ list_events | json  }}">
        <header class="flex flex-col md:flex-row justify-between md:items-center mb-10 -mt-1.5">
            <div class="text-black-numixs flex flex-col items-start">
                <h1 class="title-font font-bold text-6xl">Tableau de bord</h1>
                {% include "includes/dropdown-places.njk" %}
            </div>
        </header>
        <div class="flex flex-col gap-3 mb-4">
            {% include "includes/hello-banner.njk" %}
        </div>
        <header class="flex gap-4 mb-6 justify-between sm:justify-normal text-black-numixs">
            {% include "includes/date-nav.njk" %}
        </header>
        {% set todayLink = "/dashboard" %}
        {% include "includes/calendar.njk" %}
        <div class="text-black-numixs">
            <div class="flex flex-col md:flex-row gap-y-5 justify-between mb-2">
                <nav class="flex flex-row text-lg items-center">
                    <p class="mr-1.5 font-bold whitespace-nowrap">Visites par</p>
                    <ul class="flex flex-row gap-1.5 overflow-auto whitespace-nowrap px-2 py-1.5">
                        <li>
                            <a class="underline hocus:no-underline rounded-md px-2 py-0.5 {{ "bg-green-numixs" if query_params.filtre == "visite" or query_params.filtre is not defined else ""}}" href="{{ formatQueryParams({ filtre: "visite", lieu: lieu or "", date: current_date|date("yyyy-LL-dd") or "" }, true) }}">Type</a>
                        </li>
                        <li>
                            <a class="underline hocus:no-underline rounded-md px-2 py-0.5 {{ "bg-green-numixs" if query_params.filtre == "genre" else ""}}" href="{{ formatQueryParams({ filtre: "genre", lieu: lieu or "", date: current_date|date("yyyy-LL-dd") or "" }, true) }}">Genre</a>
                        </li>
                        <li>
                            <a class="underline hocus:no-underline rounded-md px-2 py-0.5 {{ "bg-green-numixs" if query_params.filtre == "age" else ""}}" href="{{ formatQueryParams({ filtre: "age", lieu: lieu or "", date: current_date|date("yyyy-LL-dd") or "" }, true) }}">Tranche d'âge</a>
                        </li>
                        <li>
                            <a class="underline hocus:no-underline rounded-md px-2 py-0.5 {{ "bg-green-numixs" if query_params.filtre == "departement" else ""}}" href="{{ formatQueryParams({ filtre: "departement", lieu: lieu or "", date: current_date|date("yyyy-LL-dd") or "" }, true) }}">Département</a>
                        </li>
                    </ul>
                </nav>
                <label class="gap-3 w-fit inline-flex items-center cursor-pointer rounded-md {{ options.label_classes if options.label_classes else default_options.label_classes }}">
                    <input type="checkbox" checked class="sr-only peer" data-switch-toggle-charts-sync="{{ name }}">
                    <span class="relative z-50">Synchroniser les graphiques</span>
                    <div class="relative z-50 switch border-solid border-black-numixs/30 border w-11 h-6 bg-[#C3CAD8] peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-dark-green-numixs/30 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:bg-black-numixs peer-checked:after:border-black-numixs after:content-[''] after:absolute after:border-black-numixs/30 after:top-[1px] after:start-[1px] after:bg-white after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-numixs"></div>
                </label>
            </div>
            {% set menu_chart_classes = "absolute right-3 flex flex-col items-end gap-3" %}
            <div class="grid grid-cols-1 xl:grid-cols-2 2xl:grid-cols-3 gap-2">
                <div class="bg-black-numixs p-3 rounded-2xl h-120 relative">
                    <menu class="{{ menu_chart_classes }}">
                        <li>
                            {{ macros.download_chart_extensible_button("daily-chart") }}
                        </li>
                        <li>
                            {{ macros.zoom_chart_extensible_button("jour", "detailsChartModal") }}
                        </li>
                    </menu>
                    <canvas id="daily-chart" class="w-full h-full"></canvas>
                </div>
                <div class="bg-black-numixs p-3 rounded-2xl h-120 relative">
                    <menu class="{{ menu_chart_classes }}">
                        <li>
                            {{ macros.download_chart_extensible_button("weekly-chart") }}
                        </li>
                        <li>
                            {{ macros.zoom_chart_extensible_button("semaine", "detailsChartModal") }}
                        </li>
                    </menu>
                    <canvas id="weekly-chart"></canvas>
                </div>
                <div class="bg-black-numixs p-3 rounded-2xl h-120 relative col-span-full 2xl:col-[initial]">
                    <menu class="{{ menu_chart_classes }}">
                        <li>
                            {{ macros.download_chart_extensible_button("monthly-chart") }}
                        </li>
                        <li>
                            {{ macros.zoom_chart_extensible_button("mois", "detailsChartModal") }}
                        </li>
                    </menu>
                    <canvas id="monthly-chart"></canvas>
                </div>
                <div class="col-span-full bg-black-numixs p-3 rounded-2xl h-150 relative">
                    <menu class="{{ menu_chart_classes }}">
                        <li>
                            {{ macros.download_chart_extensible_button("yearly-chart") }}
                        </li>
                        <li>
                            {{ macros.zoom_chart_extensible_button("annee", "detailsChartModal") }}
                        </li>
                    </menu>
                    <canvas id="yearly-chart"></canvas>
                </div>
                <div class="col-span-full bg-black-numixs p-3 rounded-2xl h-150 relative">
                    <menu class="{{ menu_chart_classes }}">
                        <li>
                            {{ macros.download_chart_extensible_button("all-chart") }}
                        </li>
                        <li>
                            {{ macros.zoom_chart_extensible_button("tous", "detailsChartModal") }}
                        </li>
                    </menu>
                    <canvas id="all-chart"></canvas>
                </div>
            </div>
        </div>

        <dialog id="detailsChartModal" closedby="any" class="max-w-7xl w-full mx-auto text-white-numixs backdrop:bg-white-numixs/20 mt-8 bg-transparent">
            <div class="bg-black-numixs p-3 border border-green-numixs rounded-2xl mx-3 ">
                <div class="relative">
                    <menu class="absolute right-3 flex flex-row gap-3">
                        <li>
                            {% set split_button_main_action %}
                            <button data-download-chart="detailsChart" type="button" class="text-gray-numixs cursor-pointer">
                                Exporter graphique + tableau (.jpg)
                            </button>
                            {% endset %}

                            {% set split_button_sub_action_1 %}
                            <a href="" data-download-chart-data="simple" download class="w-full items-center inline-flex justify-center whitespace-nowrap flex-row gap-2 px-3.5 py-2.5 rounded-md text-black hocus:bg-slate-300">
                                <span class="size-6">
                                    {% include "includes/icons/download-fill-icon.svg" %}
                                </span>
                                Télécharger les données visite par visite (.csv)
                            </a>
                            {% endset %}
                            {% set split_button_sub_action_2 %}
                            {# <a href="" data-download-chart-data="detailed" download class="w-full align-center inline-flex whitespace-nowrap flex-row gap-2 px-3.5 py-2.5 rounded-md text-black hocus:bg-slate-300">
                            {% include "includes/icons/download-fill-icon.svg" %}
                                Télécharger les données simplifiée groupe par groupe (.csv)
                            </a> #}
                            {% endset %}

                            {# split_button_sub_action_2 #}
                            {% set list_sub_actions = [split_button_sub_action_1] %}
                            {{ macros.split_button(
                            split_button_main_action,
                            list_sub_actions,
                            true
                        ) }}
                        </li>
                        <li class="flex">
                            <button autofocus type="button" command="close" commandfor="detailsChartModal" class="text-white-numixs hocus:text-green-numixs cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </li>
                    </menu>
                    <canvas id="detailsChart" class="w-full"></canvas>
                </div>
                <div class="overflow-x-auto rounded-md">
                    <table id="table-details-chart" class="w-full mt-4 whitespace-nowrap table-col-hover" style="width: 100%; border-collapse: collapse;">
                        <caption>
                            Détails
                        </caption>
                        <thead></thead>
                        <tbody></tbody>
                        <tfoot></tfoot>
                    </table>
                </div>
            </div>
        </dialog>

        <template id="table-details-chart-thead-row">
            <th class="px-2"></th>
        </template>
        <template id="table-details-chart-tbody-row">
            <td></td>
        </template>
    {% endblock %}
