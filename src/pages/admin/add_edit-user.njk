{% extends "layouts/admin.njk" %}

{% block title %}
    {% if is_edit %}
        Éditer utilisateur
    {% else %}
        Créer utilisateur
    {% endif %}
{% endblock %}

{% if current_user.id == user.id %}
    {% set active_menu_item = "mon-compte" %}
{% else %}
    {% set active_menu_item = "utilisateurs" %}
{% endif %}

{% set active_user_menu_item = "infos" %}

{% import "includes/macros.njk" as macros %}

{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/user-form.ts" defer></script>
        <script type="module" src="/src/assets/scripts/toggle-input-visibility.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/toggle-input-visibility.ts'].file }}" defer></script>
        <script type="module" src="/{{ manifest['src/assets/scripts/user-form.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}

{% set date_format = "dd/LL/yyyy à HH:mm" %}
{% set root_class = "admin" %}
{% block content %}
    <div class="bg-slate-50 rounded-md py-5 px-6 md:py-10 md:px-13">
        {% include "includes/admin-user-nav.njk" %}
        <header class="flex flex-row justify-between md:items-center mb-10 -mt-1.5">
            <h1 class="text-black-numixs title-font font-bold text-4xl md:text-6xl">
                {% if is_edit %}
                Éditer utilisateur
                {% else %}
                Créer utilisateur
                {% endif %}
            </h1>
        </header>

        {% include "includes/hello-banner.njk" %}

        <div class="text-black-numixs">
            <form action="" method="post" data-special-opening-form>
                <div class="flex flex-col gap-2.5">
                    {% if flash_message == "error" or flash_message == "update_error" %}
                        {{ macros.error_banner("Une erreur est survenue.")}}
                        <p class="p-4 bg-red-50 text-red-800 border-t-4 border-t-red-800 rounded-md">Une erreur est survenue</p>
                    {% endif %}

                    {% if is_edit and user | length == 0 %}
                        {{ macros.error_banner("Cet utilisateur n'existe pas.")}}
                    {% endif %}

                    {% if flash_message == "update_success" %}
                        {{ macros.success_banner("L'utilisateur a été mis à jour avec succès.")}}
                    {% endif %}

                    <ul class="form-errors-list-container" role="alert" data-form-errors id="error-container"></ul>
                    <p class="p-4 bg-blue-50 text-blue-800 border-t-4 border-t-blue-800 rounded-md">Les champs avec * sont obligatoires</p>
                </div>

                <input type="hidden" name="id" value="{{ user.id }}">

                <div class="flex flex-col gap-5">
                    <div class="flex flex-col">
                        <label for="nom" class="font-bold text-lg">Nom</label>
                        <input type="text" id="nom" name="nom" value="{{ user.nom }}">
                    </div>
                    <div class="flex flex-col">
                        <label for="prenom" class="font-bold text-lg">Prénom</label>
                        <input type="text" id="prenom" name="prenom" value="{{ user.prenom }}">
                    </div>

                    <div class="flex flex-col">
                        <label for="email" class="font-bold text-lg">E-mail*</label>
                        <input type="text" class="readonly: text-black-numixs/80" id="email" name="email" readonly value="{{ user.email }}">
                    </div>

                    {# <div class="flex flex-col">
                    <label for="email" class="font-bold text-lg">Mot de passe*</label>
                    <input type="text" id="email" name="nom" value="">
                </div> #}

                    <div class="flex flex-col">
                        <label for="role" class="font-bold text-lg inline-flex items-center gap-2">Rôle*
                        <button type="button" class="align-middle hocus:opacity-80" title="Voir détails" commandfor="detail-roles" command="show-modal" data-event-data='{{ event | json }}'>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 0 1 .67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 1 1-.671-1.34l.041-.022ZM12 9a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        </label>
                        <div class="has-inert:cursor-not-allowed">
                            <select name="role" id="role" class="inert:text-black-numixs/80 w-full" {{ "inert" if user_role.weight < 100 or user.role == "ADMIN" else "" }}>
                                {% for role in list_roles %}
                                    <option {{ "selected" if user.role == role.value else "" }} value="{{ role.value }}">
                                        {{ role.label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-col">
                        <p class="font-bold text-lg">Activer</p>
                        <div class="flex flex-row gap-5 has-disabled:opacity-80 has-disabled:cursor-not-allowed">
                            {% set can_edit_active_status = (user.actif == 1 and user.role == "ADMIN") or user_role.weight < 100 %}
                            <div>
                                <label for="oui">Oui</label>
                                <input type="radio" name="actif" {{ "disabled" if can_edit_active_status else "" }} {{ "checked" if user.actif == 1 else "" }} id="oui" value="1">
                            </div>
                            <div>
                                <label for="non">Non</label>
                                <input type="radio" name="actif" {{ "disabled" if can_edit_active_status else "" }} {{ "checked" if user.actif == 0 else "" }} id="non" value="0">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="text-black-numixs inline-flex w-fit title-font rounded-md text-2xl gap-2.5 py-3.5 font-bold hocus:opacity-70 items-center">
                Soumettre
                <svg width="23" height="22" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0.723633 11C0.723633 13.0767 1.37686 15.1068 2.60072 16.8335C3.82458 18.5602 5.56409 19.906 7.59929 20.7007C9.63449 21.4955 11.874 21.7034 14.0345 21.2982C16.1951 20.8931 18.1797 19.8931 19.7373 18.4246C21.295 16.9562 22.3558 15.0852 22.7856 13.0484C23.2153 11.0116 22.9948 8.90045 22.1518 6.98182C21.3088 5.0632 19.8812 3.42332 18.0495 2.26957C16.2179 1.11581 14.0645 0.5 11.8616 0.5C8.90763 0.5 6.07465 1.60625 3.98587 3.57538C1.89709 5.54451 0.723633 8.21523 0.723633 11ZM5.49705 10.25H15.1632L10.7239 6.04475L11.8616 5L18.2262 11L11.8616 17L10.7239 15.9298L15.1632 11.75H5.49705V10.25Z" fill="currentColor"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
{% include "includes/detail-roles.njk" %}
{% endblock %}
