{% extends "layouts/admin.njk" %}

{% block title %}
{% if is_edit %}
Éditer lieu "{{ place.nom }}"
{% else %}
Créer nouveau lieu Numixs
{% endif %}
{% endblock %}

{% import "includes/macros.njk" as macro %}

{% block scripts %}
    {% if NODE_ENV == "development" %}
        <script type="module" src="/src/assets/scripts/forms/place-form.ts" defer></script>
    {% else %}
        <script type="module" src="/{{ manifest['src/assets/scripts/forms/place-form.ts'].file }}" defer></script>
    {% endif %}
{% endblock %}

{% set active_menu_item = "lieu" %}
{% set date_format = "dd/LL/yyyy à HH:mm" %}
{% set root_class = "admin" %}
{% block content %}
<div class="bg-slate-50 rounded-md py-5 px-6 md:py-10 md:px-13">
    <header class="flex flex-row justify-between md:items-center mb-10 -mt-1.5">
        <h1 class="text-black-numixs title-font font-bold text-4xl md:text-6xl">
            {% if is_edit %}
            Éditer lieu "{{ place.nom }}"
            {% else %}
            Créer nouveau lieu Numixs
            {% endif %}
        </h1>
    </header>
    {% include "includes/hello-banner.njk" %}

    <div class="text-black-numixs">
        <form action="" method="post" data-place-form>
            <div class="flex flex-col gap-2.5">
                {% include "includes/form-banner-success.njk" %}
                <ul class="form-errors-list-container" role="alert" data-form-errors id="error-container"></ul>
                {{ macro.info_banner("Les champs avec * sont obligatoires.") }}
            </div>

            <div class="flex flex-col gap-5">
                <div class="flex flex-col">
                    <label for="nom" class="font-bold text-lg">Nom*</label>
                    <input type="text" id="nom" name="nom" value="{{ place.nom }}">
                </div>
                <div class="flex flex-col">
                    <label for="adresse" class="font-bold text-lg">Adresse</label>
                    <textarea name="adresse" id="adresse">{{ place.adresse }}</textarea>
                </div>
                <div class="flex flex-col">
                    <label for="jours" class="font-bold text-lg">Jours de fermeture</label>
                    <select id="jours" name="jours_fermeture" multiple>
                        {% for day in list_days %}
                            <option {{ "selected" if place.jours_fermeture.includes(day.value) else "" }} value="{{ day.value }}">{{ day.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="flex flex-col">
                    <p class="font-bold text-lg">Horaires</p>
                    {{ macro.info_banner("Note : Si le lieu ferme à une heure pile, cette dernière ne sera jamais affichée dans les graphiques du tableau de bord.
                    Par exemple, si un lieu est ouvert de 10h à 17h, il ne sera visible que les heures de 10h à 16h dans les graphiques du tableau de bord.") }}
                    <div class="flex flex-row gap-5">
                        <div class="flex flex-col">
                            <p>Ouverture</p>
                            <div class="flex flex-row gap-1">
                                <select name="heure_ouverture_heure" value="{{ place.heure_ouverture_heure }}" id="heure_ouverture_heure">
                                    {% for i in range(8, 20) %}
                                        <option {{ "selected" if place.heure_ouverture_heure == i else "" }} value="{{ i|pad("0", 2) }}">{{ i|pad("0", 2) }}h</option>
                                    {% endfor %}
                                </select>
                                <select name="heure_ouverture_minutes" value="{{ place.heure_ouverture_minutes }}" id="heure_ouverture_minutes">
                                    {% for i in range(0, 60) %}
                                        <option {{ "selected" if place.heure_ouverture_minutes == i else "" }} value="{{ i|pad("0", 2) }}">{{ i|pad("0", 2) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="flex flex-col">
                            <p>Fermeture</p>
                            <div class="flex flex-row gap-1">
                                <select name="heure_fermeture_heure" value="{{ place.heure_fermeture_heure }}" id="heure_fermeture_heure">
                                    {% for i in range(8, 20) %}
                                        <option {{ "selected" if place.heure_fermeture_heure == i|pad('0', 2) else "" }} value="{{ i|pad("0", 2) }}">{{ i|pad("0", 2) }}h</option>
                                    {% endfor %}
                                </select>
                                <select name="heure_fermeture_minutes" value="{{ place.heure_fermeture_minutes }}" id="heure_fermeture_minutes">
                                    {% for i in range(0, 60) %}
                                        <option {{ "selected" if place.heure_fermeture_minutes == i|pad("0", 2) else "" }} value="{{ i|pad("0", 2) }}">{{ i|pad("0", 2) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col">
                    <label for="type" class="font-bold text-lg">Type</label>
                    <select id="type" name="type" class="custom-select">
                        <button>
                            <selectedcontent></selectedcontent>
                        </button>

                        {% for type in list_place_types %}
                            <option {{ "selected" if place.type == type.value else "" }} value="{{ type.value }}">
                                <img width="100" src="/images/logos/{{ type.logo }}" alt="">
                                <span>{{ type.label }}</span>
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="flex flex-col">
                    <p class="font-bold text-lg">Ouvert*</p>
                    <div class="flex flex-row gap-5">
                        <div>
                            <label for="oui">Oui</label>
                            <input type="radio" name="ouvert" {{ "checked" if place.ouvert == 1 else "" }} value="1" id="oui">
                        </div>
                        <div>
                            <label for="non">Non</label>
                            <input type="radio" name="ouvert" {{ "checked" if place.ouvert == 0 else "" }} value="0" id="non">
                        </div>
                    </div>
                </div>
                <button type="submit" class="{{ primary_button_classes }}">
                    Soumettre
                    <svg width="23" height="22" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.723633 11C0.723633 13.0767 1.37686 15.1068 2.60072 16.8335C3.82458 18.5602 5.56409 19.906 7.59929 20.7007C9.63449 21.4955 11.874 21.7034 14.0345 21.2982C16.1951 20.8931 18.1797 19.8931 19.7373 18.4246C21.295 16.9562 22.3558 15.0852 22.7856 13.0484C23.2153 11.0116 22.9948 8.90045 22.1518 6.98182C21.3088 5.0632 19.8812 3.42332 18.0495 2.26957C16.2179 1.11581 14.0645 0.5 11.8616 0.5C8.90763 0.5 6.07465 1.60625 3.98587 3.57538C1.89709 5.54451 0.723633 8.21523 0.723633 11ZM5.49705 10.25H15.1632L10.7239 6.04475L11.8616 5L18.2262 11L11.8616 17L10.7239 15.9298L15.1632 11.75H5.49705V10.25Z" fill="currentColor"></path>
                    </svg>
                </button>
            </div>
        </div>
    </form>
</div>
{% endblock %}
