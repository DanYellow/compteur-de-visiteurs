{
    "name": "compteur-de-visiteurs",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "cross-env NODE_ENV=development cross-env NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json server/index.ts",
        "dev:docker": "tsx watch --include \"./server/*\" --include \"./src/*\" server/index.ts",
        "build": "cross-env NODE_ENV=production tsc && vite build",
        "build:server": "vite build --config vite.config.server.ts",
        "email": "npx @tailwindcss/cli -i ./src/assets/styles/email.css -o ./dist/tailwind-email.tmp.css --minify && npx postcss ./dist/tailwind-email.tmp.css -o ./dist/tailwind-email.css",
        "prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate && node ./dist/server/index.js"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.18",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/vite": "^4.1.13",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/express-session": "^1.18.2",
        "@types/ip": "^1.1.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/luxon": "^3.7.1",
        "@types/multer": "^2.1.0",
        "@types/node": "^24.5.2",
        "@types/nodemailer": "^7.0.4",
        "@types/nunjucks": "^3.2.6",
        "@types/papaparse": "^5.5.2",
        "@types/ws": "^8.18.1",
        "autoprefixer": "^10.4.23",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "postcss-logical": "^8.1.0",
        "tailwindcss": "^4.1.13",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.6",
        "typescript": "~5.8.3",
        "vite": "^7.1.2",
        "vite-tsconfig-paths": "^6.0.4"
    },
    "dependencies": {
        "@ownid/webauthn": "^1.0.0",
        "@simplewebauthn/server": "^13.2.2",
        "base64url": "^3.0.1",
        "bcryptjs": "^3.0.3",
        "chart.js": "^4.5.1",
        "chartjs-plugin-datalabels": "^2.2.0",
        "choices.js": "^11.1.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "cross-env": "^10.0.0",
        "csv-parse": "^6.1.0",
        "csv-parser": "^3.2.0",
        "csv-stringify": "^6.6.0",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.18.2",
        "ip": "^2.0.1",
        "jsonwebtoken": "^9.0.3",
        "juice": "^11.0.3",
        "luxon": "^3.7.2",
        "multer": "^2.1.1",
        "nodemailer": "^7.0.11",
        "nunjucks": "^3.2.4",
        "papaparse": "^5.5.3",
        "sequelize": "^6.37.7",
        "sqlite3": "^5.1.7",
        "ws": "^8.18.3",
        "zod": "^4.1.9"
    },
    "imports": {
        "#server/utils/*": "./server/utils/*.ts",
        "#server/*": "./server/*.ts",
        "#models/*": "./models/*.ts",
        "#scripts/*": "./src/assets/scripts/*.ts",
        "#types": "./types.ts",
        "#styles/*.css": "./src/assets/styles/*.css"
    }
}
