PORT=3900
# MUST BE 32 chars long at least
JWT_SECRET=
# MUST BE 32 chars long at least
JWT_APPROVAL_SECRET=
JWT_APPROVAL_EXPIRE_TIME=1d
# MUST BE 32 chars long at least
JWT_PASSKEY_SECRET=
JWT_PASSKEY_EXPIRE_TIME=1d
# MUST BE 32 chars long at least
JWT_PASSWORD_RECOVERY_SECRET=
JWT_PASSWORD_RECOVERY_EXPIRE_TIME=1d
SESSION_SECRET=
REDIS_PASSWORD=
# MUST BE a valid directory name (no space, special chars...). Using that variable will create a path, for admin, with the following structure : admin-{ADMIN_SUFFIX}. If "ADMIN_SUFFIX" is empty, the admin's url will be "admin". Using that variable improves security since it's harder to find the admin's url
ADMIN_SUFFIX=
EMAIL_NOREPLY=
EMAIL_PASSWORD_NOREPLY=
EMAIL_SERVER_NOREPLY=
# MUST MATCH THE SITE'S DOMAIN OR ELSE THE PASSKEYS WON'T WORK
HOSTNAME=
DEFAULT_ADMIN_PASSWORD=hello_world
# Display logging for sequelize (dev only)
ENABLE_SEQUELIZE_LOGGING=false
